APP_HOST=0.0.0.0
APP_PORT=8991
LOG_LEVEL=INFO

# Khi chạy orchestrator trực tiếp trên host/local.
LLM_BASE_URL=http://127.0.0.1:8005
LLM_WS_BASE_URL=ws://127.0.0.1:8005
TTS_BASE_URL=http://127.0.0.1:8989
LIPSYNC_BASE_URL=http://127.0.0.1:8990

# Chỉ cần đổi các biến dưới đây nếu upstream không chạy trên cùng Docker host.
# Không đặt chúng thành 127.0.0.1 khi orchestrator chạy trong container.
DOCKER_LLM_BASE_URL=http://host.docker.internal:8005
DOCKER_LLM_WS_BASE_URL=ws://host.docker.internal:8005
DOCKER_TTS_BASE_URL=http://host.docker.internal:8989
DOCKER_LIPSYNC_BASE_URL=http://host.docker.internal:8990

# Nếu compose LipSync publish API_PORT khác mặc định, đặt đúng cổng host, ví dụ:
# DOCKER_LIPSYNC_BASE_URL=http://host.docker.internal:8990

# CHARACTER_ID chỉ là nhân vật mặc định cho client cũ không gửi character_id.
CHARACTER_ID=to_vinh_dien
VOICE_ID=001
IMAGE_ID=001
VO_THI_SAU_VOICE_ID=002
VO_THI_SAU_IMAGE_ID=002
KIM_DONG_VOICE_ID=003
KIM_DONG_IMAGE_ID=003
LE_VAN_TAM_VOICE_ID=004
LE_VAN_TAM_IMAGE_ID=004
NGUYEN_VAN_TROI_VOICE_ID=005
NGUYEN_VAN_TROI_IMAGE_ID=005
LE_HONG_PHONG_VOICE_ID=006
LE_HONG_PHONG_IMAGE_ID=006
NGUYEN_BINH_KHIEM_VOICE_ID=007
NGUYEN_BINH_KHIEM_IMAGE_ID=007
NGUYEN_BA_NGOC_VOICE_ID=008
NGUYEN_BA_NGOC_IMAGE_ID=008
LE_CHAN_VOICE_ID=009
LE_CHAN_IMAGE_ID=009
LE_NGOC_HAN_VOICE_ID=010
LE_NGOC_HAN_IMAGE_ID=010
DINH_NUP_VOICE_ID=011
DINH_NUP_IMAGE_ID=011
NGO_QUYEN_VOICE_ID=012
NGO_QUYEN_IMAGE_ID=012
QUANG_TRUNG_NGUYEN_HUE_VOICE_ID=013
QUANG_TRUNG_NGUYEN_HUE_IMAGE_ID=013
LE_LOI_VOICE_ID=014
LE_LOI_IMAGE_ID=014

LLM_TIMEOUT_SECONDS=45
TTS_TIMEOUT_SECONDS=900
LIPSYNC_TIMEOUT_SECONDS=3600
VIDEO_DOWNLOAD_TIMEOUT_SECONDS=300
POLL_INTERVAL_SECONDS=2

# Chạy backend trực tiếp trên host: cấu hình đường dẫn ảnh thật nếu có.
# CHARACTER_IMAGE_PATH=/home/cbrain/ai_digital_hero/LipSync_CB/images/001.jpg
# VO_THI_SAU_IMAGE_PATH=/home/cbrain/ai_digital_hero/LipSync_CB/images/002.jpg
# KIM_DONG_IMAGE_PATH=/home/cbrain/ai_digital_hero/LipSync_CB/images/003.jpg
