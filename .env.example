# QUANG_TRUNG_NGUYEN_HUE_IMAGE_HOST_PATH=/home/cbrain/ai_digital_hero/LipSync_CB/images/013.jpg
# LE_LOI_IMAGE_HOST_PATH=/home/cbrain/ai_digital_hero/LipSync_CB/images/014.jpg

# Ảnh nhóm mới (đường dẫn host khi chạy Docker).
# PHAM_NGOC_THAO_IMAGE_HOST_PATH=/home/cbrain/ai_digital_hero/LipSync_CB/images/015.jpg
# VU_NGOC_NHA_IMAGE_HOST_PATH=/home/cbrain/ai_digital_hero/LipSync_CB/images/016.jpg
# DANG_TRAN_DUC_IMAGE_HOST_PATH=/home/cbrain/ai_digital_hero/LipSync_CB/images/017.jpg
