# NGUYEN_BA_NGOC_IMAGE_PATH=/home/cbrain/ai_digital_hero/LipSync_CB/images/008.jpg
# LE_CHAN_IMAGE_PATH=/home/cbrain/ai_digital_hero/LipSync_CB/images/009.jpg
# LE_NGOC_HAN_IMAGE_PATH=/home/cbrain/ai_digital_hero/LipSync_CB/images/010.jpg
# DINH_NUP_IMAGE_PATH=/home/cbrain/ai_digital_hero/LipSync_CB/images/011.jpg
